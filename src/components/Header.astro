---
const { compact=false } = Astro.props;
const links=compact ? [['/','Beranda'],['/tiket-masuk/','Tiket'],['/aktivitas-wisata/','Aktivitas'],['/kuliner-akomodasi/','Kebutuhan'],['/#peta','Peta']] : [['#kisah','Tentang'],['#kunjungan','Kunjungan'],['#akses','Akses'],['/tiket-masuk/','Tiket'],['/aktivitas-wisata/','Aktivitas'],['/kuliner-akomodasi/','Kebutuhan'],['#peta','Peta']];
---
<header class="site-header relative z-40 border-b border-white/15 bg-river-900 text-white">
 <div class="container-page header-inner"><a href="/" class="focus-ring flex min-h-11 items-center gap-3" aria-label="Beranda Menara Pandang Banjarmasin"><img src="/icons/favicon.svg" alt="" class="h-11 w-11"/><span><strong class="block font-serif text-lg">Menara Pandang</strong><span class="text-xs tracking-widest">BANJARMASIN</span></span></a><nav aria-label="Navigasi utama" class="main-nav">{links.map(([href,label])=><a class="focus-ring" href={href}>{label}</a>)}</nav></div>
</header>
