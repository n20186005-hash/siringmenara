---
const { compact=false } = Astro.props;
---
<header class="absolute inset-x-0 top-0 z-40 border-b border-white/15 bg-river-900/45 text-white backdrop-blur-md">
  <div class="container-page flex min-h-20 items-center justify-between gap-4">
    <a href="/" class="focus-ring flex items-center gap-3 rounded-sm" aria-label="Beranda Panduan Menara Pandang Banjarmasin">
      <span class="grid h-11 w-11 place-items-center rounded-full bg-sand-100 shadow-sm"><img src="/icons/favicon.svg" alt="" class="h-9 w-9" /></span>
      <span class="hidden sm:block"><strong class="block font-serif text-lg leading-tight">Menara Pandang</strong><span class="text-[10px] font-bold tracking-[.24em] text-white/70">BANJARMASIN</span></span>
    </a>
    <nav aria-label="Navigasi utama" class="flex flex-wrap items-center gap-3 text-sm font-semibold sm:gap-5">
      {!compact && <><a class="focus-ring rounded-sm hover:text-sand-200" href="#kisah">Kisah</a><a class="focus-ring rounded-sm hover:text-sand-200" href="#kunjungan">Kunjungan</a><a class="focus-ring rounded-sm hover:text-sand-200" href="#akses">Akses</a></>}
      <a class="focus-ring rounded-sm hover:text-sand-200" href="/tiket-masuk/">Tiket</a>
      <a class="focus-ring rounded-sm hover:text-sand-200" href="/aktivitas-wisata/">Aktivitas</a>
      <a class="focus-ring rounded-sm hover:text-sand-200" href="/kuliner-akomodasi/">Kuliner</a>
      <a class="focus-ring rounded-full border border-white/40 px-4 py-2 hover:bg-white hover:text-river-900" href={compact ? '/' : '#peta'}>Peta</a>
    </nav>
  </div>
</header>
