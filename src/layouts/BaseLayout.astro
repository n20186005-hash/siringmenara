---
import '@/styles/global.css';
import { SITE_NAME } from '@/data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image='/images/menara-hero.webp', noindex=false } = Astro.props;
const canonical = !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : undefined;
const gaId = 'G-HXM22WWPKP';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffaf1" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <script is:inline define:vars={{ gaId }}>
      (() => {
        const key = 'menara-cookie-consent';
        const vetoKey = key + '-denied';
        const id = gaId;
        if (window.setMenaraAnalytics) return;
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
        let loaded = false;
        let currentAllow = null;
        window.readMenaraConsent = () => {
          let data = {};
          try { data = JSON.parse(localStorage.getItem(key) || '{}') || {}; } catch {}
          try { if (sessionStorage.getItem(vetoKey) === '1') data.analytics = false; } catch { data.analytics = false; }
          if (currentAllow !== null) data.analytics = currentAllow;
          return data;
        };
        window.setMenaraAnalytics = (allow) => {
          let sessionSaved = false;
          try {
            if (allow) {
              sessionStorage.removeItem(vetoKey);
              if (sessionStorage.getItem(vetoKey) === '1') throw new Error('Veto retained');
            } else sessionStorage.setItem(vetoKey, '1');
            sessionSaved = true;
          } catch {
            if (allow) {
              try { if (sessionStorage.getItem(vetoKey) === '1') allow = false; } catch { allow = false; }
            }
          }
          currentAllow = allow;
          window['ga-disable-' + id] = !allow;
          window.gtag('consent', 'update', { analytics_storage: allow ? 'granted' : 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
          if (allow && !loaded) {
            loaded = true;
            window.gtag('js', new Date());
            window.gtag('config', id, { anonymize_ip: true });
            const s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
            document.head.appendChild(s);
          }
          return sessionSaved;
        };
        window.addEventListener('storage', (event) => {
          if (event.key !== key) return;
          let granted = false;
          try { granted = JSON.parse(event.newValue || '{}').analytics === true; } catch {}
          if (!granted) window.setMenaraAnalytics(false);
          window.dispatchEvent(new Event('menara:consent-change'));
        });
        window.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
        window.setMenaraAnalytics(window.readMenaraConsent().analytics === true);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
