---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_NAME } from '@/data/site';

const siteUrl = Astro.site?.href?.replace(/\/$/, '');
const placeUrl = siteUrl ? `${siteUrl}/` : undefined;
const faq = [
  { q:'Apakah Menara Pandang Banjarmasin cocok untuk kunjungan singkat?', a:'Ya. Untuk menikmati bangunan, panorama Sungai Martapura, dan area siring, alokasikan sekitar 60–90 menit. Jika digabung dengan pasar terapung, wisata sungai, atau berjalan di koridor siring, sediakan waktu lebih panjang.' },
  { q:'Kapan waktu yang paling nyaman untuk datang?', a:'Pagi memberi udara yang relatif lebih sejuk dan suasana sungai yang hidup, sedangkan sore menjelang malam cocok untuk menikmati perubahan cahaya kota. Akhir pekan dan waktu acara publik cenderung lebih ramai.' },
  { q:'Apakah ada biaya masuk?', a:'Tarif masuk resmi yang konsisten tidak ditemukan pada kanal pemerintah yang kami periksa. Kawasan siring berfungsi sebagai ruang publik, tetapi parkir, wisata sungai, atau layanan tertentu dapat memiliki biaya terpisah. Ikuti papan tarif dan informasi petugas di lokasi.' },
  { q:'Apakah ada akses ke lantai atas?', a:'Pemerintah kota mengumumkan pembukaan kembali area rooftop pada 2025 dan menyebut layanan lift pada jam tertentu. Karena operasional dapat berubah akibat perawatan, cuaca, atau kegiatan, konfirmasikan kondisi terkini ketika tiba.' },
  { q:'Apakah lokasi mudah dicapai tanpa kendaraan pribadi?', a:'Kawasan berada di pusat Banjarmasin dan dapat dicapai dengan taksi, transportasi berbasis aplikasi, serta jaringan angkutan kota. Bus Trans Banjarmasin melayani beberapa koridor kota; titik turun terbaik dan koneksi terakhir perlu disesuaikan dengan layanan yang berjalan pada hari kunjungan.' },
  { q:'Apa yang perlu diperhatikan saat membawa anak atau lansia?', a:'Pilih waktu yang tidak terlalu panas, bawa air minum, gunakan alas kaki yang tidak licin, dan awasi anak di area tepi sungai. Untuk pengunjung dengan mobilitas terbatas, tanyakan status lift dan akses bebas hambatan di lokasi sebelum naik.' },
];
const structuredData = {
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':['TouristAttraction','LocalBusiness'],
      name:'Menara Pandang Banjarmasin',
      description:'Menara pandang dan ruang wisata publik di kawasan Siring Sungai Martapura, pusat Kota Banjarmasin.',
      ...(placeUrl ? {url:placeUrl} : {}),
      ...(siteUrl ? {image:[`${siteUrl}/images/menara-hero.webp`,`${siteUrl}/images/menara-day.webp`]} : {}),
      address:{'@type':'PostalAddress',streetAddress:'Jl. Kapten Piere Tendean No.07, RT.16/RW.2',addressLocality:'Banjarmasin',addressRegion:'Kalimantan Selatan',postalCode:'70123',addressCountry:'ID'},
      geo:{'@type':'GeoCoordinates',latitude:-3.3169893,longitude:114.5905432},
      aggregateRating:{'@type':'AggregateRating',ratingValue:'4.5',reviewCount:'7983',bestRating:'5'},
      openingHoursSpecification:[
        {'@type':'OpeningHoursSpecification','dayOfWeek':['Monday','Tuesday','Wednesday','Thursday','Friday'],'opens':'10:00','closes':'21:00'},
        {'@type':'OpeningHoursSpecification','dayOfWeek':'Saturday','opens':'10:00','closes':'22:00'},
        {'@type':'OpeningHoursSpecification','dayOfWeek':'Sunday','opens':'08:00','closes':'21:00'}
      ],
      publicAccess:true
    },
    {'@type':'FAQPage',mainEntity:faq.map(({q,a})=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}
  ]
};
---
<BaseLayout title={`${SITE_NAME} — Harga Tiket, Jam Buka & Lokasi Siring`} description="Info lengkap Menara Pandang Siring Banjarmasin: harga tiket masuk, jam operasional, lokasi Jl. Kapten Piere Tendean, akses, fasilitas, dan tips kunjungan terbaru.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="relative min-h-[92svh] overflow-hidden bg-river-900 text-white">
    <Header />
    <img src="/images/menara-hero.webp" alt="Menara Pandang Banjarmasin di tepi Sungai Martapura" width="1920" height="1080" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-center" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(13,48,50,.92)_0%,rgba(13,48,50,.62)_48%,rgba(13,48,50,.18)_100%)]"></div>
    <div class="absolute -right-24 top-24 h-[34rem] w-[15rem] rotate-6 border border-white/15 bg-white/5 backdrop-blur-[2px]"></div>
    <div class="container-page relative z-10 flex min-h-[92svh] items-end pb-16 pt-36 md:pb-24">
      <div class="max-w-4xl">
        <p class="mb-5 text-xs font-bold uppercase tracking-[.28em] text-orange-200">Kota Seribu Sungai • Kalimantan Selatan</p>
        <h1 class="display text-[clamp(4rem,11vw,8.8rem)]">Melihat Banjarmasin<br/><span class="text-orange-300">dari tepi sungai.</span></h1>
        <p class="mt-7 max-w-2xl text-base leading-8 text-white/78 md:text-lg">Menara Pandang berdiri di koridor Siring Tendean, tempat arsitektur kota, pergerakan Sungai Martapura, pasar terapung, dan ruang publik bertemu. Panduan ini membantu memahami tempatnya—bukan sekadar mengambil foto.</p>
        <div class="mt-9 flex flex-wrap gap-3"><a href="#kunjungan" class="focus-ring rounded-full bg-tower-500 px-6 py-3 text-sm font-extrabold text-white shadow-lg hover:bg-tower-600">Rencanakan kunjungan</a><a href="#kisah" class="focus-ring rounded-full border border-white/35 bg-white/5 px-6 py-3 text-sm font-extrabold backdrop-blur hover:bg-white hover:text-river-900">Baca kisah tempat</a></div>
      </div>
    </div>
    <div class="absolute bottom-5 right-5 rounded-full border border-white/20 bg-black/25 px-3 py-1.5 text-[10px] text-white/75 backdrop-blur">Foto: Ilham Mufti Laksono • CC BY 4.0</div>
  </div>

  <main>
    <section class="border-b border-ink-900/10 bg-sand-100 py-5" aria-label="Ringkasan cepat">
      <div class="container-page grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <div class="border-l-2 border-tower-500 pl-4"><span class="block text-xs font-bold uppercase tracking-widest text-ink-600">Lokasi</span><strong>Banjarmasin Tengah</strong></div>
        <div class="border-l-2 border-tower-500 pl-4"><span class="block text-xs font-bold uppercase tracking-widest text-ink-600">Karakter</span><strong>Menara kota & siring sungai</strong></div>
        <div class="border-l-2 border-tower-500 pl-4"><span class="block text-xs font-bold uppercase tracking-widest text-ink-600">Waktu ideal</span><strong>Pagi atau sore</strong></div>
        <div class="border-l-2 border-tower-500 pl-4"><span class="block text-xs font-bold uppercase tracking-widest text-ink-600">Durasi saran</span><strong>60–90 menit</strong></div>
      </div>
    </section>

    <section id="kisah" class="relative overflow-hidden py-24 md:py-32">
      <div class="absolute -left-20 top-20 h-80 w-80 rounded-full border-[50px] border-river-300/20"></div>
      <div class="container-page relative grid items-start gap-14 lg:grid-cols-[.9fr_1.1fr]">
        <div class="lg:sticky lg:top-8"><p class="eyebrow">Kisah tempat</p><h2 class="section-title mt-4">Sebuah balkon kota di Sungai Martapura.</h2><p class="section-copy mt-6">Banjarmasin tumbuh dalam hubungan yang rapat dengan sungai. Menara Pandang memakai posisi tepian itu sebagai titik baca: melihat arus air, jalur perahu, siring, jembatan, dan kepadatan pusat kota dalam satu bingkai.</p></div>
        <div class="space-y-8">
          <article class="paper p-7 md:p-10"><span class="mb-5 block font-serif text-5xl text-tower-500">2014</span><h3 class="font-serif text-3xl">Menara diresmikan sebagai penanda baru tepian sungai Banjarmasin</h3><p class="mt-4 text-ink-600">Informasi pariwisata Pemerintah Provinsi Kalimantan Selatan mencatat peresmian Menara Pandang pada 24 Juni 2014. Kehadirannya memperkuat kawasan Siring Tendean sebagai ruang rekreasi kota di tepian Sungai Martapura.</p></article>
          <article class="grid gap-0 overflow-hidden rounded-[2rem] bg-river-900 text-white md:grid-cols-2"><img src="/images/kuriding.webp" alt="Dokumentasi Kuriding yang dipamerkan pada galeri Menara Pandang" loading="lazy" class="h-full min-h-80 w-full object-cover"/><div class="p-8 md:p-10"><p class="text-xs font-bold uppercase tracking-[.2em] text-river-300">Bukan panorama saja</p><h3 class="mt-3 font-serif text-3xl">Ruang untuk mengenali budaya lokal</h3><p class="mt-4 text-white/72">Dokumentasi di dalam menara pernah menampilkan materi budaya seperti Kuriding, alat musik tradisional Kalimantan Selatan. Karena materi pamer dapat berubah, nikmati menara sebagai pintu masuk untuk memahami lanskap budaya Banjar yang lebih luas.</p><p class="mt-6 text-xs text-white/50">Foto: Mia Sulisnawati • CC BY-SA 4.0</p></div></article>
          <article class="border-l-4 border-tower-500 pl-7"><h3 class="font-serif text-3xl">Rooftop kembali dibuka pada 2025</h3><p class="mt-3 text-ink-600">Dinas Kebudayaan, Kepemudaan, Olahraga dan Pariwisata Kota Banjarmasin mengumumkan pembukaan kembali lantai rooftop pada April 2025. Pengumuman itu juga menyebut pengoperasian lift pada dua rentang waktu harian. Status operasional tetap perlu dicek ketika berkunjung karena pemeliharaan dapat berubah.</p></article>
        </div>
      </div>
    </section>

    <section class="bg-river-900 py-24 text-white md:py-32">
      <div class="container-page"><div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr]"><div><p class="text-xs font-bold uppercase tracking-[.2em] text-river-300">Cara membaca panorama</p><h2 class="section-title mt-4">Lihat sungai sebagai jalan utama kota lama.</h2></div><div class="grid gap-4 sm:grid-cols-3"><div class="rounded-3xl border border-white/12 p-6"><span class="text-3xl">01</span><h3 class="mt-6 font-serif text-2xl">Arus & perahu</h3><p class="mt-3 text-sm text-white/68">Perhatikan bagaimana sungai tetap berfungsi sebagai ruang mobilitas, perdagangan, dan rekreasi.</p></div><div class="rounded-3xl border border-white/12 p-6"><span class="text-3xl">02</span><h3 class="mt-6 font-serif text-2xl">Siring & kota</h3><p class="mt-3 text-sm text-white/68">Bandingkan tepian sungai yang ditata dengan bangunan kota di belakangnya—dua lapis Banjarmasin yang hidup bersamaan.</p></div><div class="rounded-3xl border border-white/12 p-6"><span class="text-3xl">03</span><h3 class="mt-6 font-serif text-2xl">Waktu</h3><p class="mt-3 text-sm text-white/68">Pagi, siang, dan sore mengubah aktivitas, suhu, warna air, dan kepadatan ruang secara nyata.</p></div></div></div></div>
    </section>

    <section id="kunjungan" class="py-24 md:py-32">
      <div class="container-page">
        <div class="mb-12 max-w-3xl"><p class="eyebrow">Panduan kunjungan</p><h2 class="section-title mt-4">Datang dengan konteks, pulang dengan cerita.</h2><p class="section-copy mt-6">Informasi operasional dapat berubah. Bagian ini membedakan antara data rujukan publik dan saran kunjungan agar Anda tahu apa yang perlu diverifikasi.</p></div>
        <div class="grid gap-5 lg:grid-cols-3">
          <article class="rounded-[2rem] bg-sand-200 p-7 lg:row-span-2"><p class="text-xs font-bold uppercase tracking-widest text-tower-600">Jam rujukan</p><h3 class="mt-3 font-serif text-3xl">Waktu operasional yang dipublikasikan</h3><dl class="mt-7 space-y-4 text-sm"><div class="flex justify-between gap-4 border-b border-ink-900/10 pb-3"><dt>Senin–Jumat</dt><dd class="font-bold">10.00–21.00 WITA</dd></div><div class="flex justify-between gap-4 border-b border-ink-900/10 pb-3"><dt>Sabtu</dt><dd class="font-bold">10.00–22.00 WITA</dd></div><div class="flex justify-between gap-4 border-b border-ink-900/10 pb-3"><dt>Minggu</dt><dd class="font-bold">08.00–21.00 WITA</dd></div></dl><div class="mt-6 rounded-2xl bg-white/70 p-4 text-sm text-ink-600"><strong class="text-ink-900">Catatan rooftop/lift:</strong> pengumuman 2025 menyebut layanan lift 08.00–11.00 dan 16.00–21.00. Jadwal menara dan lift dapat berubah; cek kembali di lokasi atau kanal pemerintah.</div></article>
          <article class="rounded-[2rem] border border-ink-900/10 p-7"><span class="text-4xl">☀</span><h3 class="mt-5 font-serif text-2xl">Pagi</h3><p class="mt-2 text-sm text-ink-600">Lebih nyaman untuk berjalan dan memberi peluang melihat aktivitas sungai sejak awal hari. Cocok bila ingin menggabungkan pasar terapung.</p></article>
          <article class="rounded-[2rem] border border-ink-900/10 p-7"><span class="text-4xl">◐</span><h3 class="mt-5 font-serif text-2xl">Sore</h3><p class="mt-2 text-sm text-ink-600">Cahaya lebih lembut dan suasana siring mulai ramai. Datang lebih awal agar tidak bergantung pada akses rooftop menjelang tutup.</p></article>
          <article class="rounded-[2rem] border border-ink-900/10 p-7"><span class="text-4xl">⌁</span><h3 class="mt-5 font-serif text-2xl">60–90 menit</h3><p class="mt-2 text-sm text-ink-600">Cukup untuk menara dan area siring. Tambahkan waktu bila ingin menyusuri sungai atau mempelajari titik budaya di sekitarnya.</p></article>
          <article class="rounded-[2rem] border border-ink-900/10 p-7"><span class="text-4xl">◎</span><h3 class="mt-5 font-serif text-2xl">Biaya</h3><p class="mt-2 text-sm text-ink-600">Belum ditemukan tarif masuk resmi yang konsisten pada kanal pemerintah yang diperiksa. Parkir, perahu wisata, atau layanan tambahan dapat berbayar; ikuti tarif resmi yang terpasang.</p></article>
        </div>
      </div>
    </section>

    <section id="akses" class="river-grid border-y border-ink-900/10 bg-white py-24 md:py-32">
      <div class="container-page"><div class="grid gap-12 lg:grid-cols-[.78fr_1.22fr]"><div><p class="eyebrow">Transportasi rinci</p><h2 class="section-title mt-4">Menuju tepi Sungai Martapura.</h2><p class="section-copy mt-6">Alamat tujuan: Jl. Kapten Piere Tendean No.07, RT.16/RW.2, Gadang, Banjarmasin Tengah, Kota Banjarmasin, Kalimantan Selatan 70123.</p></div>
      <div class="space-y-4">
        <details open class="group rounded-3xl border border-ink-900/10 bg-sand-100 p-6"><summary class="cursor-pointer list-none font-serif text-2xl font-bold">Dari Bandara Internasional Syamsudin Noor <span class="float-right font-sans text-base">＋</span></summary><div class="mt-4 grid gap-4 text-sm text-ink-600 sm:grid-cols-2"><p><strong class="text-ink-900">Taksi / transportasi berbasis aplikasi:</strong> opsi paling langsung menuju pusat Banjarmasin. Gunakan titik jemput resmi di area kedatangan dan pastikan tarif/metode pembayaran sebelum berangkat.</p><p><strong class="text-ink-900">Bus bandara:</strong> bandara pernah mempublikasikan layanan Airport Bus. Karena rute dan jam dapat berubah, periksa papan transportasi di terminal; lanjutkan perjalanan terakhir ke Siring Tendean dengan angkutan kota, taksi, atau berjalan bila titik turun memungkinkan.</p></div></details>
        <details class="group rounded-3xl border border-ink-900/10 bg-sand-100 p-6"><summary class="cursor-pointer list-none font-serif text-2xl font-bold">Dengan Bus Trans Banjarmasin <span class="float-right font-sans text-base">＋</span></summary><p class="mt-4 text-sm text-ink-600">Pemerintah kota mengoperasikan Bus Trans Banjarmasin pada beberapa koridor. Karena halte, koneksi, dan pola layanan dapat berubah, cari koridor yang mendekati Banjarmasin Tengah lalu lanjutkan ke Jl. Kapten Piere Tendean. Hindari mengandalkan satu jadwal lama; konfirmasi melalui kanal Dinas Perhubungan pada hari perjalanan.</p></details>
        <details class="group rounded-3xl border border-ink-900/10 bg-sand-100 p-6"><summary class="cursor-pointer list-none font-serif text-2xl font-bold">Taksi, transportasi aplikasi & kendaraan sewaan <span class="float-right font-sans text-base">＋</span></summary><p class="mt-4 text-sm text-ink-600">Gunakan “Menara Pandang Banjarmasin” atau alamat lengkap sebagai tujuan. Untuk penjemputan kembali, pilih titik yang aman dan tidak menghalangi arus Jl. Kapten Piere Tendean. Saat ada acara atau pengaturan lalu lintas, bersiap berjalan beberapa ratus meter dari titik turun alternatif.</p></details>
        <details class="group rounded-3xl border border-ink-900/10 bg-sand-100 p-6"><summary class="cursor-pointer list-none font-serif text-2xl font-bold">Lewat sungai <span class="float-right font-sans text-base">＋</span></summary><p class="mt-4 text-sm text-ink-600">Kawasan siring memiliki dermaga dan koneksi wisata sungai. Perahu/kelotok adalah pengalaman khas Banjarmasin, tetapi layanan bukan pengganti angkutan terjadwal. Sepakati tujuan, durasi, kapasitas, perlengkapan keselamatan, dan harga sebelum naik.</p></details>
      </div></div></div>
    </section>

    <section class="py-24 md:py-32">
      <div class="container-page"><div class="mb-12 grid gap-6 lg:grid-cols-2"><div><p class="eyebrow">Fasilitas & kebutuhan praktis</p><h2 class="section-title mt-4">Hal kecil yang menentukan kenyamanan.</h2></div><p class="section-copy self-end">Kami tidak merekomendasikan merek atau usaha tertentu. Informasi berikut berfokus pada jenis layanan yang biasanya dibutuhkan pengunjung dan cara mengeceknya secara netral.</p></div>
      <div class="grid gap-px overflow-hidden rounded-[2rem] border border-ink-900/10 bg-ink-900/10 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['WC','Cari toilet umum di kompleks siring/menara; bawa uang kecil dan perlengkapan pribadi karena fasilitas dapat berubah.'],
          ['Parkir','Gunakan ruang parkir resmi di sekitar kawasan. Cek papan tarif retribusi; jangan parkir di bahu jalan yang mengganggu akses warga atau lalu lintas.'],
          ['Makan & minum','Di koridor pusat kota tersedia warung, kedai, rumah makan, dan penjual makanan lokal. Pilih berdasarkan kebersihan, harga yang tercantum, dan kebutuhan diet.'],
          ['Akomodasi','Pilihan penginapan kota tersedia dari kelas sederhana hingga hotel. Utamakan akses transportasi, kebijakan pembatalan, dan jarak berjalan yang sesuai.'],
          ['Belanja harian','Minimarket, pasar, apotek, dan toko kebutuhan harian tersedia di kawasan pusat kota. Bawa air minum sebelum berjalan di siring.'],
          ['BBM & pengisian daya','SPBU tersedia di jaringan jalan kota. Pengisian kendaraan listrik perlu direncanakan melalui peta operator resmi karena titik dan status charger dapat berubah.'],
          ['Aksesibilitas','Lift pernah diumumkan beroperasi untuk akses rooftop pada jam tertentu. Pengguna kursi roda atau alat bantu sebaiknya mengecek status lift dan permukaan jalur sebelum kunjungan.'],
          ['Wi-Fi & sinyal','Pemerintah kota mencatat titik Wi-Fi publik di kawasan Siring Sungai Menara Pandang. Kualitas koneksi dapat bervariasi; jangan gunakan jaringan publik untuk transaksi sensitif.']
        ].map(([t,d]) => <article class="bg-sand-100 p-6"><h3 class="font-serif text-2xl">{t}</h3><p class="mt-3 text-sm text-ink-600">{d}</p></article>)}
      </div></div>
    </section>

    <section class="py-24 md:py-32">
      <div class="container-page">
        <div class="mb-12 max-w-3xl"><p class="eyebrow">Panduan mendalam</p><h2 class="section-title mt-4">Rencanakan dari satu halaman.</h2><p class="section-copy mt-6">Buka panduan khusus untuk detail tiket, aktivitas di tepian sungai, serta pilihan kuliner dan penginapan di sekitar Menara Pandang.</p></div>
        <div class="grid gap-4 md:grid-cols-3">
          <a href="/tiket-masuk/" class="group rounded-3xl border border-ink-900/10 bg-white p-7 transition hover:border-tower-500"><span class="text-xs font-bold uppercase tracking-widest text-tower-600">Biaya</span><h3 class="mt-3 font-serif text-2xl">Harga Tiket Masuk</h3><p class="mt-3 text-sm text-ink-600">Tarif, retribusi parkir, dan layanan berbayar seperti perahu wisata.</p><span class="mt-5 inline-block text-sm font-bold text-river-700 group-hover:underline">Baca panduan →</span></a>
          <a href="/aktivitas-wisata/" class="group rounded-3xl border border-ink-900/10 bg-white p-7 transition hover:border-tower-500"><span class="text-xs font-bold uppercase tracking-widest text-tower-600">Aktivitas</span><h3 class="mt-3 font-serif text-2xl">Aktivitas Wisata</h3><p class="mt-3 text-sm text-ink-600">Pasar terapung, wisata sungai, dan momen terbaik di Siring Tendean.</p><span class="mt-5 inline-block text-sm font-bold text-river-700 group-hover:underline">Baca panduan →</span></a>
          <a href="/kuliner-akomodasi/" class="group rounded-3xl border border-ink-900/10 bg-white p-7 transition hover:border-tower-500"><span class="text-xs font-bold uppercase tracking-widest text-tower-600">Sekitar</span><h3 class="mt-3 font-serif text-2xl">Kuliner &amp; Penginapan</h3><p class="mt-3 text-sm text-ink-600">Cita rasa Banjar dan pilihan menginap dekat Menara Pandang.</p><span class="mt-5 inline-block text-sm font-bold text-river-700 group-hover:underline">Baca panduan →</span></a>
        </div>
      </div>
    </section>

    <section class="bg-sand-200 py-24 md:py-32">
      <div class="container-page grid gap-12 lg:grid-cols-[1fr_1fr]"><div><p class="eyebrow">Kuliner di sekitar</p><h2 class="section-title mt-4">Cari rasa Banjar tanpa daftar sponsor.</h2><p class="section-copy mt-6">Alih-alih menunjuk usaha tertentu, gunakan kategori berikut sebagai panduan eksplorasi. Bandingkan kebersihan, harga yang jelas, kepadatan, dan kebutuhan diet Anda.</p><div class="mt-8 flex flex-wrap gap-2 text-sm font-bold"><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Soto Banjar</span><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Ketupat Kandangan</span><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Ikan sungai</span><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Kue tradisional Banjar</span><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Kopi & minuman dingin</span></div></div><div class="overflow-hidden rounded-[2rem] bg-river-900"><img src="/images/dayak.webp" alt="Kegiatan budaya di kawasan Menara Pandang dan Siring Banjarmasin" loading="lazy" class="aspect-[4/3] h-full w-full object-cover opacity-90"/><p class="p-4 text-xs text-white/55">Foto kegiatan budaya: Yasir Habibie • CC BY-SA 4.0</p></div></div>
    </section>

    <section class="py-24 md:py-32">
      <div class="container-page"><div class="mb-12 max-w-3xl"><p class="eyebrow">Jelajah sekitar</p><h2 class="section-title mt-4">Satu koridor, banyak lapisan kota.</h2><p class="section-copy mt-6">Objek berikut tercantum dalam data pariwisata Pemerintah Kota Banjarmasin. Urutannya bukan peringkat dan tidak mengandung rekomendasi komersial.</p></div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4"><article class="rounded-3xl border border-ink-900/10 p-6"><span class="text-xs font-bold text-tower-600">SUNGAI</span><h3 class="mt-4 font-serif text-2xl">Pasar Terapung Siring Tendean</h3><p class="mt-3 text-sm text-ink-600">Aktivitas pasar di sungai yang membantu memahami hubungan perdagangan dan kehidupan kota dengan Martapura.</p></article><article class="rounded-3xl border border-ink-900/10 p-6"><span class="text-xs font-bold text-tower-600">WARISAN</span><h3 class="mt-4 font-serif text-2xl">Rumah Anno 1925</h3><p class="mt-3 text-sm text-ink-600">Bangunan yang memberi konteks tambahan pada sejarah arsitektur dan ruang kota di sekitar koridor siring.</p></article><article class="rounded-3xl border border-ink-900/10 p-6"><span class="text-xs font-bold text-tower-600">RUANG PUBLIK</span><h3 class="mt-4 font-serif text-2xl">Taman Siring 0 Km</h3><p class="mt-3 text-sm text-ink-600">Bagian lain dari jaringan ruang publik tepian sungai; cocok disambungkan dengan berjalan kaki bila cuaca mendukung.</p></article><article class="rounded-3xl border border-ink-900/10 p-6"><span class="text-xs font-bold text-tower-600">IKON FAUNA</span><h3 class="mt-4 font-serif text-2xl">Taman Maskot Bekantan</h3><p class="mt-3 text-sm text-ink-600">Ruang publik yang mengangkat bekantan sebagai fauna identitas Kalimantan Selatan.</p></article></div></div>
    </section>

    <section class="bg-river-900 py-24 text-white"><div class="container-page grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><div><p class="text-xs font-bold uppercase tracking-[.2em] text-river-300">Etika & keselamatan</p><h2 class="section-title mt-4">Ruang publik yang dibagi bersama.</h2></div><div class="grid gap-4 sm:grid-cols-2"><div class="rounded-3xl bg-white/6 p-6"><h3 class="font-serif text-2xl">Tepi sungai</h3><p class="mt-3 text-sm text-white/68">Awasi anak, hindari duduk atau memanjat pagar, dan ekstra hati-hati saat permukaan basah.</p></div><div class="rounded-3xl bg-white/6 p-6"><h3 class="font-serif text-2xl">Panas & hujan</h3><p class="mt-3 text-sm text-white/68">Gunakan pelindung matahari, air minum, dan perlindungan hujan. Hentikan aktivitas di area terbuka saat cuaca buruk.</p></div><div class="rounded-3xl bg-white/6 p-6"><h3 class="font-serif text-2xl">Foto & budaya</h3><p class="mt-3 text-sm text-white/68">Minta izin sebelum memotret orang dari dekat, terutama pedagang, pekerja, atau peserta kegiatan budaya.</p></div><div class="rounded-3xl bg-white/6 p-6"><h3 class="font-serif text-2xl">Sampah & kebisingan</h3><p class="mt-3 text-sm text-white/68">Bawa kembali sampah bila tempat sampah penuh dan hormati warga, pejalan kaki, serta kegiatan publik lain.</p></div></div></div></section>

    <section id="peta" class="py-24 md:py-32"><div class="container-page"><div class="mb-10 grid gap-5 lg:grid-cols-2"><div><p class="eyebrow">Peta lokasi</p><h2 class="section-title mt-4">Jl. Kapten Piere Tendean.</h2></div><p class="section-copy self-end">Peta Google berikut dimuat dalam Bahasa Indonesia dan menggunakan konteks wilayah Indonesia. Peta merupakan layanan pihak ketiga dan dapat memproses data sesuai kebijakan Google.</p></div><div class="overflow-hidden rounded-[2rem] border border-ink-900/10 shadow-2xl"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6887.502875783776!2d114.59054321243954!3d-3.3169892966439054!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2de423c1879e1fb1%3A0xc531a6a5acab5a0!2sMenara%20Pandang%20Banjarmasin!5e1!3m2!1sid!2sid!4v1787106571239!5m2!1sid!2sid" width="1200" height="600" style="border:0;width:100%;height:min(65vh,600px)" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="Peta Menara Pandang Banjarmasin"></iframe></div></div></section>

