---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { withSiteName } from '@/data/site';

const faq = [
  { q:'Apa kuliner khas dekat Menara Pandang?', a:'Di koridor pusat kota tersedia Soto Banjar, Ketupat Kandangan, ikan sungai, kue tradisional Banjar, serta kopi dan minuman dingin. Kami tidak merekomendasikan merek tertentu; bandingkan kebersihan, harga yang tercantum, dan kebutuhan diet Anda.' },
  { q:'Apakah ada hotel dekat Menara Pandang Banjarmasin?', a:'Pilihan penginapan kota tersedia dari kelas sederhana hingga hotel. Utamakan akses transportasi, kebijakan pembatalan, dan jarak berjalan yang sesuai dengan rencana kunjungan Anda.' },
  { q:'Di mana makan dengan harga jelas di sekitar siring?', a:'Warung, kedai, rumah makan, dan penjual makanan lokal tersebar di koridor pusat kota. Pilih tempat dengan harga yang terpampang jelas dan perhatikan kebersihan serta kepadatan.' },
  { q:'Apakah mudah mencari minimarket dan kebutuhan harian?', a:'Minimarket, pasar, apotek, dan toko kebutuhan harian tersedia di kawasan pusat kota. Sebaiknya bawa air minum sendiri sebelum berjalan lama di siring.' },
];
const structuredData = {
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'FAQPage',mainEntity:faq.map(({q,a})=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}
  ]
};
---
<BaseLayout title={withSiteName('Kuliner & Penginapan Dekat Menara Pandang Banjarmasin')} description="Kuliner dan penginapan di sekitar Menara Pandang Banjarmasin: Soto Banjar, Ketupat Kandangan, ikan sungai, kue Banjar, serta tips memilih hotel dekat Siring Tendean.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="relative h-56 bg-river-900"><Header compact /></div>
  <main class="container-page py-16">
    <article class="mx-auto max-w-3xl">
      <p class="eyebrow">Sekitar Menara Pandang</p>
      <h1 class="mt-4 font-serif text-5xl md:text-6xl">Kuliner &amp; Penginapan Terdekat</h1>
      <p class="mt-5 text-lg text-ink-600">Cita rasa Banjar dan pilihan menginap di sekitar Menara Pandang Banjarmasin—tanpa daftar sponsor.</p>

      <section class="mt-10 rounded-[2rem] bg-sand-200 p-7 md:p-10">
        <h2 class="font-serif text-3xl">Kuliner khas Banjar</h2>
        <p class="mt-4 text-ink-600">Alih-alih menunjuk usaha tertentu, gunakan kategori berikut sebagai panduan eksplorasi. Bandingkan kebersihan, harga yang jelas, kepadatan, dan kebutuhan diet Anda.</p>
        <div class="mt-6 flex flex-wrap gap-2 text-sm font-bold"><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Soto Banjar</span><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Ketupat Kandangan</span><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Ikan sungai</span><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Kue tradisional Banjar</span><span class="rounded-full border border-ink-900/15 bg-white px-4 py-2">Kopi & minuman dingin</span></div>
      </section>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Makan dengan harga jelas</h3><p class="mt-3 text-sm text-ink-600">Warung, kedai, rumah makan, dan penjual lokal tersebar di koridor pusat kota. Pilih tempat dengan harga terpampang dan perhatikan kebersihan.</p></div>
        <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Memilih penginapan</h3><p class="mt-3 text-sm text-ink-600">Utamakan akses transportasi, kebijakan pembatalan, dan jarak berjalan ke Siring Tendean sesuai rencana kunjungan Anda.</p></div>
        <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Kebutuhan harian</h3><p class="mt-3 text-sm text-ink-600">Minimarket, pasar, apotek, dan toko harian tersedia di pusat kota. Bawa air minum sebelum berjalan lama di siring.</p></div>
        <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Pengisian daya</h3><p class="mt-3 text-sm text-ink-600">SPBU ada di jaringan jalan kota. Pengisian kendaraan listrik perlu direncanakan melalui peta operator resmi karena status charger dapat berubah.</p></div>
      </div>

      <section class="mt-10"><h2 class="font-serif text-3xl">Pertanyaan umum</h2><div class="mt-5 divide-y divide-ink-900/10">{faq.map(({q,a},i)=><details class="py-5" open={i===0}><summary class="cursor-pointer list-none pr-8 font-serif text-xl font-bold">{q}</summary><p class="mt-3 max-w-2xl text-sm leading-7 text-ink-600">{a}</p></details>)}</div></section>

      <nav aria-label="Panduan terkait" class="mt-10 flex flex-wrap gap-3 text-sm font-bold">
        <a class="rounded-full border border-ink-900/15 bg-white px-4 py-2 hover:border-tower-500" href="/tiket-masuk/">Harga tiket masuk →</a>
        <a class="rounded-full border border-ink-900/15 bg-white px-4 py-2 hover:border-tower-500" href="/aktivitas-wisata/">Aktivitas wisata →</a>
        <a class="rounded-full bg-river-700 px-4 py-2 text-white hover:bg-river-900" href="/">Kembali ke panduan utama</a>
      </nav>
    </article>
  </main>
  <Footer />
</BaseLayout>
