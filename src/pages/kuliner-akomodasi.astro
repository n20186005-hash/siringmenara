---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
const data={"title": "Kebutuhan Sekitar Menara Pandang: Kuliner, Akomodasi & Fasilitas", "h1": "Persiapan Praktis di Sekitar Siring", "intro": "Daftar ini membantu menanyakan kebutuhan perjalanan. Tidak ada daftar usaha, ketersediaan kamar atau fasilitas yang dijamin beroperasi.", "cards": [["Makan & minum", "Bila memilih tempat makan, periksa jam layanan, harga yang tercantum, kebersihan dan kebutuhan diet. Bawa air minum serta kebutuhan pribadi tanpa mengandalkan semua pedagang buka."], ["Akomodasi", "Periksa lokasi, ketersediaan kamar, waktu masuk, kebijakan pembatalan dan rute pulang dengan penyedia. Jarak di peta tidak menjamin jalur berjalan yang dapat digunakan."], ["Toilet & mobilitas", "Tanyakan lokasi toilet, tempat istirahat, permukaan jalur dan akses naik maupun turun. Pengumuman lift 2025 tidak menjamin lift bekerja sekarang atau rute bebas tangga lengkap."], ["Transportasi & kebutuhan lain", "Cari ATM, apotek, bahan bakar atau pengisian daya melalui penyedia yang relevan dan cek jam layanannya. Atur titik jemput pulang; panduan ini tidak menjamin fasilitas maupun koneksi tersedia."]], "faq": [["Apakah panduan ini merekomendasikan restoran atau hotel tertentu?", "Tidak. Bandingkan informasi langsung dari penyedia tentang harga, kebersihan, diet, akses dan kebijakan pemesanan. Situs ini tidak menerima pemesanan atau menjual layanan."], ["Apakah semua fasilitas tersedia saat menara buka?", "Belum tentu. Waktu toilet, parkir, pedagang dan layanan lain perlu diperiksa tersendiri, termasuk saat ada pemeliharaan atau kegiatan."], ["Apakah pengguna kursi roda dapat naik dengan lift?", "Jangan menganggap akses bebas tangga tersedia. Tanyakan status lift, pintu masuk, jalur lantai atas dan cara turun kepada petugas sebelum kunjungan."], ["Apa yang perlu disiapkan sebelum berangkat?", "Konfirmasi akses menara, cuaca, kebutuhan pribadi, fasilitas yang dibutuhkan dan rencana perjalanan pulang. Bawa air minum serta alas kaki yang sesuai."]]};
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:data.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<BaseLayout title={data.title} description={data.intro}><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><Header compact/><main class="container-page py-16"><article class="mx-auto max-w-4xl"><p class="eyebrow">Panduan independen · Diperiksa 19 Oktober 2026</p><h1 class="mt-4 font-serif text-5xl md:text-6xl">{data.h1}</h1><p class="mt-6 text-lg text-ink-600">{data.intro}</p><div class="mt-10 grid gap-5 sm:grid-cols-2">{data.cards.map(([t,d])=><section class="rounded-3xl border border-ink-900/10 bg-white p-7"><h2 class="font-serif text-2xl">{t}</h2><p class="mt-4 text-sm text-ink-600">{d}</p></section>)}</div><section class="mt-12"><h2 class="font-serif text-3xl">Pertanyaan umum</h2><div class="mt-5 divide-y divide-ink-900/10">{data.faq.map(([q,a])=><details class="py-5"><summary class="font-serif text-xl font-bold">{q}</summary><p class="mt-4 text-sm text-ink-600">{a}</p></details>)}</div></section><p class="mt-10 text-sm">Sumber dan batasan: <a class="underline" href="/#kisah">konteks tempat & pengumuman historis</a> · <a class="underline" href="/#kunjungan">snapshot Maps 19 Oktober 2026</a>. Tidak ada jadwal atau tarif saat ini yang dijamin.</p><nav aria-label="Panduan terkait" class="mt-8 flex flex-wrap gap-4 font-bold"><a href="/">Panduan utama</a><a href="/tiket-masuk/">Tiket</a><a href="/aktivitas-wisata/">Aktivitas</a><a href="/kuliner-akomodasi/">Kebutuhan sekitar</a></nav></article></main><Footer/></BaseLayout>
