---
import BaseLayout from '@/layouts/BaseLayout.astro';import Header from '@/components/Header.astro';import Footer from '@/components/Footer.astro';
const photos=[
 ['menara-hero.webp','Menara Pandang Banjarmasin 001.jpg','Ilham Mufti Laksono','by'],
 ['menara-day.webp','Menara Pandang Banjarmasin di siang hari.jpg','Sam Hidayat','by-sa'],
 ['menara-portrait.webp','Menara Pandang Banjarmasin (2).jpg','Fandy Aprianto Rohman','by-sa'],
 ['kuriding.webp','Gambar Kuriding.jpg','Mia Sulisnawati','by-sa'],
 ['dayak.webp','Culture Of Dayaknese.jpg','Yasir Habibie','by-sa']
];
---
<BaseLayout title="Kredit Foto & Lisensi | Menara Pandang Banjarmasin" description="Sumber Wikimedia Commons, fotografer, lisensi dan perubahan format untuk foto dokumentasi pada Panduan Menara Pandang Banjarmasin."><Header compact/><main class="container-page py-16"><article class="mx-auto max-w-4xl"><p class="eyebrow">Dokumentasi & hak gambar</p><h1 class="mt-4 font-serif text-5xl">Kredit Foto & Lisensi</h1><p class="mt-6 text-ink-600">Diperiksa 19 Oktober 2026. Foto merupakan dokumentasi pada waktu pemotretan, bukan bukti akses, pameran atau pertunjukan saat ini. Hak foto tetap pada pembuatnya; tidak ada dukungan pengelola atau fotografer yang tersirat.</p><div class="mt-10 grid gap-6 sm:grid-cols-2">{photos.map(([file,title,author,licence])=><section class="rounded-3xl border border-ink-900/10 bg-white p-6"><img src={`/images/${file}`} loading="lazy" alt={`Dokumentasi ${title.replace('.jpg','')}`} class="aspect-video w-full object-cover"/><h2 class="mt-4 font-serif text-2xl">{author}</h2><p class="mt-3 text-sm"><a class="underline" href={`https://commons.wikimedia.org/wiki/File:${encodeURIComponent(title.replaceAll(' ','_'))}`}>{title}</a> · <a class="underline" href={`https://creativecommons.org/licenses/${licence}/4.0/`}>CC {licence==='by'?'BY':'BY-SA'} 4.0</a></p><p class="mt-3 text-sm text-ink-600">Salinan web telah diubah ukuran/format menjadi WebP. Foto berlisensi BY-SA dan adaptasi foto tersebut tetap di bawah CC BY-SA 4.0.</p>{file==='dayak.webp'&&<p class="mt-3 text-sm text-ink-600">Dokumentasi budaya dari sumber tahun 2020, bukan jadwal pertunjukan harian atau acara mendatang.</p>}{file==='kuriding.webp'&&<p class="mt-3 text-sm text-ink-600">Dokumentasi alat musik, bukan jaminan pameran masih tersedia.</p>}</section>)}</div><p class="mt-10"><a class="font-bold underline" href="/">Kembali ke panduan</a></p></article></main><Footer/></BaseLayout>
