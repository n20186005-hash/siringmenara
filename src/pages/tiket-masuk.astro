---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { withSiteName } from '@/data/site';

const faq = [
  { q:'Berapa harga tiket masuk Menara Pandang Banjarmasin?', a:'Tarif masuk resmi yang konsisten tidak ditemukan pada kanal pemerintah yang kami periksa. Kawasan siring berfungsi sebagai ruang publik, sehingga menara dan area tepi sungai umumnya dapat diakses tanpa membeli tiket masuk. Ikuti papan tarif resmi yang terpasang di lokasi untuk layanan apa pun yang berbayar.' },
  { q:'Apakah parkir di Menara Pandang berbayar?', a:'Ya, ruang parkir di sekitar kawasan umumnya dikenakan retribusi parkir. Besaran tarif mengikuti papan retribusi resmi di lokasi dan dapat berbeda untuk sepeda motor, mobil, dan kendaraan besar. Siapkan uang tunai kecil.' },
  { q:'Berapa biaya wisata sungai atau perahu kelotok?', a:'Perahu wisata/kelotok bukan layanan terjadwal dan harganya disepakati langsung dengan operator. Sepakati tujuan, durasi, kapasitas, perlengkapan keselamatan, dan harga sebelum naik. Kami tidak mencantumkan harga tertentu karena dapat berubah setiap musim.' },
  { q:'Apakah naik ke rooftop atau lift gratis?', a:'Pemerintah kota mengumumkan pembukaan kembali area rooftop pada 2025 dan menyebut layanan lift pada jam tertentu. Karena operasional dapat berubah akibat perawatan atau cuaca, konfirmasikan status terkini ketika tiba.' },
];
const structuredData = {
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'FAQPage',mainEntity:faq.map(({q,a})=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}
  ]
};
---
<BaseLayout title={withSiteName('Harga Tiket Masuk Menara Pandang Banjarmasin')} description="Info tarif Menara Pandang Siring Banjarmasin: tiket masuk, retribusi parkir, dan layanan berbayar seperti perahu wisata. Cek biaya terbaru sebelum berkunjung.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="relative h-56 bg-river-900"><Header compact /></div>
  <main class="container-page py-16">
    <article class="mx-auto max-w-3xl">
      <p class="eyebrow">Biaya kunjungan</p>
      <h1 class="mt-4 font-serif text-5xl md:text-6xl">Harga Tiket Masuk Menara Pandang</h1>
      <p class="mt-5 text-lg text-ink-600">Panduan biaya untuk Menara Pandang Siring Banjarmasin: apa yang gratis, apa yang berbayar, dan cara memeriksa tarif resmi sebelum berangkat.</p>

      <section class="mt-10 rounded-[2rem] border border-ink-900/10 bg-sand-100 p-7">
        <h2 class="font-serif text-3xl">Apakah ada tiket masuk?</h2>
        <p class="mt-4 text-ink-600">Tarif masuk resmi yang konsisten <strong>tidak ditemukan</strong> pada kanal pemerintah yang kami periksa. Kawasan siring berfungsi sebagai ruang publik, sehingga menara dan area tepi Sungai Martapura umumnya dapat diakses tanpa membeli tiket masuk. Hal ini membuat Menara Pandang ramah bagi pengunjung dengan anggaran terbatas yang ingin sekadar menikmati panorama kota.</p>
      </section>

      <section class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Parkir</h3><p class="mt-3 text-sm text-ink-600">Retribusi parkir umum diberlakukan di sekitar kawasan. Tarif mengikuti papan resmi dan bervariasi untuk sepeda motor, mobil, serta kendaraan besar. Siapkan uang tunai kecil.</p></div>
        <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Perahu wisata</h3><p class="mt-3 text-sm text-ink-600">Wisata sungai/kelotok disepakati langsung dengan operator. Sepakati tujuan, durasi, kapasitas, keselamatan, dan harga sebelum naik; harga dapat berubah setiap musim.</p></div>
        <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Rooftop & lift</h3><p class="mt-3 text-sm text-ink-600">Diumumkan kembali dibuka pada 2025 dengan layanan lift pada jam tertentu. Operasional dapat berubah; konfirmasikan di lokasi.</p></div>
        <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Kamera & dokumentasi</h3><p class="mt-3 text-sm text-ink-600">Foto dari area publik umumnya diperbolehkan. Minta izin sebelum memotret pedagang atau pekerja dari dekat.</p></div>
      </section>

      <section class="mt-10"><h2 class="font-serif text-3xl">Pertanyaan umum</h2><div class="mt-5 divide-y divide-ink-900/10">{faq.map(({q,a},i)=><details class="py-5" open={i===0}><summary class="cursor-pointer list-none pr-8 font-serif text-xl font-bold">{q}</summary><p class="mt-3 max-w-2xl text-sm leading-7 text-ink-600">{a}</p></details>)}</div></section>

      <nav aria-label="Panduan terkait" class="mt-10 flex flex-wrap gap-3 text-sm font-bold">
        <a class="rounded-full border border-ink-900/15 bg-white px-4 py-2 hover:border-tower-500" href="/aktivitas-wisata/">Aktivitas wisata →</a>
        <a class="rounded-full border border-ink-900/15 bg-white px-4 py-2 hover:border-tower-500" href="/kuliner-akomodasi/">Kuliner & penginapan →</a>
        <a class="rounded-full bg-river-700 px-4 py-2 text-white hover:bg-river-900" href="/">Kembali ke panduan utama</a>
      </nav>
    </article>
  </main>
  <Footer />
</BaseLayout>
