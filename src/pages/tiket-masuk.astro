---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
const data={"title": "Tiket Menara Pandang Banjarmasin: Biaya yang Perlu Dikonfirmasi", "h1": "Tiket & Biaya Menara Pandang", "intro": "Harga terkini belum terverifikasi. Akses jalur siring tidak membuktikan menara, rooftop atau lift gratis. Periksa tarif hari kunjungan sebelum membayar.", "cards": [["Tiket menara", "Tanyakan apakah perlu tiket atau reservasi, kategori yang berlaku untuk rombongan Anda, waktu masuk terakhir dan area yang termasuk. Panduan ini tidak menetapkan harga."], ["Rooftop & lift", "Konfirmasi apakah lantai atas dan lift beroperasi, serta apakah layanan memiliki syarat atau biaya tersendiri. Pengumuman pada 2025 bukan kepastian layanan saat ini."], ["Parkir", "Periksa lokasi parkir yang diperbolehkan, jenis kendaraan, tarif resmi, jam akses dan bukti pembayaran. Jangan menganggap parkir termasuk akses menara."], ["Perahu & kegiatan", "Perahu, pasar dan kegiatan sekitar bukan layanan yang otomatis termasuk tiket menara. Bila tersedia, tanyakan operator, rute, durasi, harga dan perlengkapan keselamatan."]], "faq": [["Berapa harga tiket masuk Menara Pandang sekarang?", "Tarif terkini belum terverifikasi pada pemeriksaan 19 Oktober 2026. Tanyakan tarif resmi dan kategori pengunjung kepada petugas; tidak ada angka harga atau jaminan gratis di panduan ini."], ["Apakah siring yang terbuka berarti menara gratis?", "Tidak. Jalur tepi sungai dan bangunan menara memiliki lingkup akses berbeda. Konfirmasi izin masuk, rooftop, lift dan biaya masing-masing."], ["Apakah parkir dan perahu termasuk tiket?", "Jangan menganggap demikian. Tanyakan lokasi parkir, harga, bukti pembayaran dan operator perahu secara terpisah. Ketersediaan layanan pada hari kunjungan belum dijamin."], ["Bolehkah langsung masuk malam hari?", "Jam buka terkini belum terverifikasi dan Maps yang diperiksa tidak menampilkan jam. Tanyakan akses bangunan serta penutupan sebelum mengatur kunjungan malam."]]};
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:data.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<BaseLayout title={data.title} description={data.intro}><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><Header compact/><main class="container-page py-16"><article class="mx-auto max-w-4xl"><p class="eyebrow">Panduan independen · Diperiksa 19 Oktober 2026</p><h1 class="mt-4 font-serif text-5xl md:text-6xl">{data.h1}</h1><p class="mt-6 text-lg text-ink-600">{data.intro}</p><div class="mt-10 grid gap-5 sm:grid-cols-2">{data.cards.map(([t,d])=><section class="rounded-3xl border border-ink-900/10 bg-white p-7"><h2 class="font-serif text-2xl">{t}</h2><p class="mt-4 text-sm text-ink-600">{d}</p></section>)}</div><section class="mt-12"><h2 class="font-serif text-3xl">Pertanyaan umum</h2><div class="mt-5 divide-y divide-ink-900/10">{data.faq.map(([q,a])=><details class="py-5"><summary class="font-serif text-xl font-bold">{q}</summary><p class="mt-4 text-sm text-ink-600">{a}</p></details>)}</div></section><p class="mt-10 text-sm">Sumber dan batasan: <a class="underline" href="/#kisah">konteks tempat & pengumuman historis</a> · <a class="underline" href="/#kunjungan">snapshot Maps 19 Oktober 2026</a>. Tidak ada jadwal atau tarif saat ini yang dijamin.</p><nav aria-label="Panduan terkait" class="mt-8 flex flex-wrap gap-4 font-bold"><a href="/">Panduan utama</a><a href="/tiket-masuk/">Tiket</a><a href="/aktivitas-wisata/">Aktivitas</a><a href="/kuliner-akomodasi/">Kebutuhan sekitar</a></nav></article></main><Footer/></BaseLayout>
