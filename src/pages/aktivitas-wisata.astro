---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
const data={"title": "Aktivitas Siring Menara Pandang: Tower, Tepi Sungai & Batas Akses", "h1": "Aktivitas di Menara Pandang & Siring", "intro": "Bangunan menara, pedestrian, pasar terapung dan perahu adalah bagian pengalaman yang berbeda. Rencanakan sesuai akses dan layanan yang benar-benar tersedia.", "cards": [["Menara & panorama", "Jika petugas mengonfirmasi bangunan dan lantai atas buka, ikuti batas kapasitas, jalur naik/turun serta aturan dokumentasi. Pemandangan bergantung cuaca dan jarak pandang."], ["Jalur pedestrian", "Siring Tendean adalah koridor tepian Sungai Martapura. Ikuti batas jalur dan kegiatan setempat; keterjangkauan pedestrian tidak sama dengan izin memasuki menara."], ["Pasar terapung", "Satu Data kota mencatat Pasar Terapung Siring Tendean terpisah dari Menara Pandang. Periksa apakah ada kegiatan pada tanggal rencana Anda; tidak ada jaminan pasar setiap hari atau setiap pagi."], ["Wisata perahu", "Jangan mengandalkan keberangkatan tertentu. Bila layanan tersedia, cek operator, cuaca, rute, kapasitas, perlengkapan keselamatan dan kesepakatan harga sebelum naik."]], "faq": [["Apa yang dapat direncanakan di kawasan ini?", "Mulai dengan lokasi menara dan jalur pedestrian. Akses lantai atas, kegiatan pasar, perahu dan acara perlu dikonfirmasi secara terpisah; tidak semuanya otomatis tersedia."], ["Apakah ada pertunjukan budaya setiap hari?", "Panduan ini tidak memverifikasi jadwal pertunjukan tetap. Foto dokumentasi budaya bukan pengumuman acara baru. Periksa pengumuman pemerintah atau penyelenggara untuk tanggal tertentu."], ["Apakah pasar terapung sama dengan menara?", "Bukan. Daftar objek wisata kota tahun 2024 mencatat keduanya sebagai entri berbeda. Lokasi kegiatan dan akses menara perlu diperiksa masing-masing."], ["Apakah wisata sungai selalu aman dan tersedia?", "Tidak ada jaminan. Pertimbangkan cuaca, kondisi sungai, arahan petugas dan perlengkapan keselamatan. Jangan naik bila kondisi atau layanan tidak sesuai kebutuhan Anda."]]};
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:data.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<BaseLayout title={data.title} description={data.intro}><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><Header compact/><main class="container-page py-16"><article class="mx-auto max-w-4xl"><p class="eyebrow">Panduan independen · Diperiksa 19 Oktober 2026</p><h1 class="mt-4 font-serif text-5xl md:text-6xl">{data.h1}</h1><p class="mt-6 text-lg text-ink-600">{data.intro}</p><div class="mt-10 grid gap-5 sm:grid-cols-2">{data.cards.map(([t,d])=><section class="rounded-3xl border border-ink-900/10 bg-white p-7"><h2 class="font-serif text-2xl">{t}</h2><p class="mt-4 text-sm text-ink-600">{d}</p></section>)}</div><section class="mt-12"><h2 class="font-serif text-3xl">Pertanyaan umum</h2><div class="mt-5 divide-y divide-ink-900/10">{data.faq.map(([q,a])=><details class="py-5"><summary class="font-serif text-xl font-bold">{q}</summary><p class="mt-4 text-sm text-ink-600">{a}</p></details>)}</div></section><p class="mt-10 text-sm">Sumber dan batasan: <a class="underline" href="/#kisah">konteks tempat & pengumuman historis</a> · <a class="underline" href="/#kunjungan">snapshot Maps 19 Oktober 2026</a>. Tidak ada jadwal atau tarif saat ini yang dijamin.</p><nav aria-label="Panduan terkait" class="mt-8 flex flex-wrap gap-4 font-bold"><a href="/">Panduan utama</a><a href="/tiket-masuk/">Tiket</a><a href="/aktivitas-wisata/">Aktivitas</a><a href="/kuliner-akomodasi/">Kebutuhan sekitar</a></nav></article></main><Footer/></BaseLayout>
