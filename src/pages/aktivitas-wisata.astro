---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { withSiteName } from '@/data/site';

const faq = [
  { q:'Apa saja aktivitas wisata di Menara Pandang?', a:'Menara Pandang menawarkan panorama Sungai Martapura, berjalan di koridor siring, melihat pasar terapung Siring Tendean, dan wisata sungai dengan perahu/kelotok. Area rooftop yang dibuka kembali pada 2025 memberi sudut pandang kota dari atas.' },
  { q:'Kapan waktu terbaik ke Menara Pandang?', a:'Pagi memberi udara lebih sejuk dan aktivitas sungai yang hidup, cocok bila ingin menggabungkan pasar terapung. Sore menjelang malam cocok menikmati perubahan cahaya kota. Akhir pekan dan acara publik cenderung lebih ramai.' },
  { q:'Apakah ada pasar terapung di Siring Tendean?', a:'Ya, aktivitas pasar di sungai membantu memahami hubungan perdagangan dan kehidupan kota dengan Sungai Martapura. Waktu dan intensitas kegiatan dapat berubah; pagi hari umumnya memberi kesempatan melihat aktivitas lebih awal.' },
  { q:'Apakah aman berwisata sungai dari siring?', a:'Perahu/kelotok adalah pengalaman khas Banjarmasin, tetapi bukan angkutan terjadwal. Sepakati tujuan, durasi, kapasitas, perlengkapan keselamatan, dan harga sebelum naik, serta perhatikan cuaca.' },
];
const structuredData = {
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'FAQPage',mainEntity:faq.map(({q,a})=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}
  ]
};
---
<BaseLayout title={withSiteName('Aktivitas Wisata Menara Pandang Banjarmasin')} description="Aktivitas di Siring Menara Pandang Banjarmasin: panorama Sungai Martapura, pasar terapung Siring Tendean, wisata sungai kelotok, rooftop, dan waktu terbaik berkunjung.">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="relative h-56 bg-river-900"><Header compact /></div>
  <main class="container-page py-16">
    <article class="mx-auto max-w-3xl">
      <p class="eyebrow">Aktivitas</p>
      <h1 class="mt-4 font-serif text-5xl md:text-6xl">Aktivitas Wisata di Menara Pandang</h1>
      <p class="mt-5 text-lg text-ink-600">Dari balkon kota hingga permukaan sungai—panduan aktivitas di Siring Menara Pandang Banjarmasin dan sekitarnya.</p>

      <div class="mt-10 grid gap-4">
        <div class="grid gap-0 overflow-hidden rounded-[2rem] bg-river-900 text-white md:grid-cols-2"><img src="/images/menara-day.webp" alt="Menara Pandang di siang hari tepi Sungai Martapura" loading="lazy" class="h-full min-h-72 w-full object-cover" /><div class="p-8"><p class="text-xs font-bold uppercase tracking-[.2em] text-river-300">Panorama</p><h3 class="mt-3 font-serif text-3xl">Membaca kota dari balkon sungai</h3><p class="mt-4 text-white/72">Menara Pandang memakai posisi tepian sebagai titik baca: arus air, jalur perahu, siring, jembatan, dan kepadatan pusat kota dalam satu bingkai. Rooftop yang dibuka kembali pada 2025 memberi sudut pandang dari atas.</p></div></div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Pasar terapung</h3><p class="mt-3 text-sm text-ink-600">Aktivitas pasar di sungai di Siring Tendean membantu memahami hubungan perdagangan dan kehidupan kota dengan Martapura. Pagi hari umumnya paling hidup.</p></div>
          <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Wisata sungai</h3><p class="mt-3 text-sm text-ink-600">Perahu/kelotok dari dermaga siring adalah pengalaman khas Banjarmasin. Sepakati durasi, kapasitas, keselamatan, dan harga sebelum naik.</p></div>
          <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Berjalan di siring</h3><p class="mt-3 text-sm text-ink-600">Koridor Siring Tendean cocok dijelajahi dengan berjalan kaki—menghubungkan menara, ruang publik, dan area budaya di sekitarnya.</p></div>
          <div class="rounded-3xl border border-ink-900/10 bg-white p-6"><h3 class="font-serif text-2xl">Foto & budaya</h3><p class="mt-3 text-sm text-ink-600">Dokumentasi budaya seperti Kuriding pernah dipamerkan di dalam menara. Minta izin sebelum memotret orang dari dekat.</p></div>
        </div>
      </div>

      <section class="mt-10"><h2 class="font-serif text-3xl">Pertanyaan umum</h2><div class="mt-5 divide-y divide-ink-900/10">{faq.map(({q,a},i)=><details class="py-5" open={i===0}><summary class="cursor-pointer list-none pr-8 font-serif text-xl font-bold">{q}</summary><p class="mt-3 max-w-2xl text-sm leading-7 text-ink-600">{a}</p></details>)}</div></section>

      <nav aria-label="Panduan terkait" class="mt-10 flex flex-wrap gap-3 text-sm font-bold">
        <a class="rounded-full border border-ink-900/15 bg-white px-4 py-2 hover:border-tower-500" href="/tiket-masuk/">Harga tiket masuk →</a>
        <a class="rounded-full border border-ink-900/15 bg-white px-4 py-2 hover:border-tower-500" href="/kuliner-akomodasi/">Kuliner & penginapan →</a>
        <a class="rounded-full bg-river-700 px-4 py-2 text-white hover:bg-river-900" href="/">Kembali ke panduan utama</a>
      </nav>
    </article>
  </main>
  <Footer />
</BaseLayout>
